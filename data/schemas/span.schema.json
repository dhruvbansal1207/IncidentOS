{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Span",
  "type": "object",
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "span_id": {
      "type": "string"
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "service": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "start_ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC"
    },
    "duration_ms": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    }
  },
  "required": [
    "trace_id",
    "span_id",
    "service",
    "operation",
    "start_ts",
    "duration_ms",
    "status"
  ]
}
