{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metric",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC"
    },
    "service": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "error_rate, latency_p95_ms, request_count, cpu_percent"
    },
    "value": {
      "type": "number"
    }
  },
  "required": [
    "ts",
    "service",
    "name",
    "value"
  ]
}
